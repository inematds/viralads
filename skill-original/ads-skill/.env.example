# Arcads External API credentials
# Get yours at: https://app.arcads.ai/settings/api

# Your API key — used as HTTP Basic auth username, empty password.
ARCADS_API_KEY=your_key_here

# Optional: override the base URL (default is https://external-api.arcads.ai)
# ARCADS_BASE_URL=https://external-api.arcads.ai

# Optional: a default product UUID so the skill doesn't have to create one each run.
# Get this from POST /v1/products or list with GET /v1/products.
# ARCADS_DEFAULT_PRODUCT_ID=
